Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказКлиента") Тогда		ЗаказОснование = ДанныеЗаполнения;		Клиент = ДанныеЗаполнения.Клиент;		Подразделение = ДанныеЗаполнения.Подразделение;		Договор = ДанныеЗаполнения.Договор;		Склад = ДанныеЗаполнения.Склад;		СуммаДокумента = ДанныеЗаполнения.СуммаДокумента;		Для Каждого Стр Из ДанныеЗаполнения.Товары Цикл			НоваяСтр = Товары.Добавить();			НоваяСтр.Номенклатура = Стр.Номенклатура;			НоваяСтр.Количество = Стр.Количество;			НоваяСтр.Цена = Стр.Цена;			НоваяСтр.Сумма = Стр.Сумма;			НоваяСтр.СтатьяРасходов = Стр.СтатьяРасходов;		КонецЦикла;	КонецЕсли;КонецПроцедурыПроцедура ОбработкаПроведения(Отказ, РежимПроведения)	Движения.ОстаткиТоваров.Записывать = Истина;	Движения.РезервыТоваров.Записывать = Истина;	Движения.ВзаиморасчетыСКонтрагентами.Записывать = Истина;		ИтогСумма = 0;	Для Каждого СтрокаТЧ Из Товары Цикл		Если СтрокаТЧ.Количество <= 0 Тогда			Сообщение = Новый СообщениеПользователю;			Сообщение.Текст = "Количество должно быть больше нуля в строке " + СтрокаТЧ.НомерСтроки;			Сообщение.Сообщить();			Отказ = Истина;			Возврат;		КонецЕсли;				Если Константы.КонтролироватьОстаткиПриОтгрузке.Получить() Тогда			Свободно = УправлениеЗапасамиСервер.ПолучитьСвободныйОстаток(				СтрокаТЧ.Номенклатура, Склад, МоментВремени(), ЗаказОснование);			Если Свободно < СтрокаТЧ.Количество Тогда				Сообщение = Новый СообщениеПользователю;				Сообщение.Текст = "Недостаточно товара на складе """ + СтрокаТЧ.Номенклатура 					+ """. Доступно: " + Свободно;				Сообщение.Сообщить();				Отказ = Истина;				Возврат;			КонецЕсли;		КонецЕсли;				ДвижениеОстатки = Движения.ОстаткиТоваров.ДобавитьРасход();		ДвижениеОстатки.Период = Дата;		ДвижениеОстатки.Склад = Склад;		ДвижениеОстатки.Номенклатура = СтрокаТЧ.Номенклатура;		ДвижениеОстатки.Количество = СтрокаТЧ.Количество;				Если ЗначениеЗаполнено(ЗаказОснование) Тогда			ДвижениеРезерв = Движения.РезервыТоваров.ДобавитьРасход();			ДвижениеРезерв.Период = Дата;			ДвижениеРезерв.Склад = Склад;			ДвижениеРезерв.ЗаказКлиента = ЗаказОснование;			ДвижениеРезерв.Номенклатура = СтрокаТЧ.Номенклатура;			ДвижениеРезерв.Количество = СтрокаТЧ.Количество;		КонецЕсли;				ИтогСумма = ИтогСумма + СтрокаТЧ.Сумма;	КонецЦикла;		Если ИтогСумма > 0 И ЗначениеЗаполнено(Договор) Тогда		ДвижениеДолг = Движения.ВзаиморасчетыСКонтрагентами.ДобавитьРасход();		ДвижениеДолг.Период = Дата;		ДвижениеДолг.Контрагент = Клиент;		ДвижениеДолг.Договор = Договор;		ДвижениеДолг.СуммаДолга = ИтогСумма;	КонецЕсли;КонецПроцедуры