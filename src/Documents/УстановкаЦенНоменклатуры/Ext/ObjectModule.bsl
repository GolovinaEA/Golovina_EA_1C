Процедура ОбработкаПроведения(Отказ, РежимПроведения)	Движения.ЦеныНоменклатуры.Записывать = Истина;	Для Каждого СтрокаТЧ Из Товары Цикл		Если СтрокаТЧ.Цена <= 0 Тогда			Сообщение = Новый СообщениеПользователю;			Сообщение.Текст = "Цена должна быть больше нуля в строке " + СтрокаТЧ.НомерСтроки;			Сообщение.Сообщить();			Отказ = Истина;			Возврат;		КонецЕсли;		Движение = Движения.ЦеныНоменклатуры.Добавить();		Движение.Период = Дата;		Движение.Номенклатура = СтрокаТЧ.Номенклатура;		Движение.ВидЦены = ВидЦены;		Движение.Цена = СтрокаТЧ.Цена;	КонецЦикла;КонецПроцедуры