Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда		ДокументРеализации = ДанныеЗаполнения;		Клиент = ДанныеЗаполнения.Клиент;		Подразделение = ДанныеЗаполнения.Подразделение;		Договор = ДанныеЗаполнения.Договор;		Склад = ДанныеЗаполнения.Склад;		СуммаДокумента = ДанныеЗаполнения.СуммаДокумента;		Для Каждого Стр Из ДанныеЗаполнения.Товары Цикл			НоваяСтр = Товары.Добавить();			НоваяСтр.Номенклатура = Стр.Номенклатура;			НоваяСтр.Количество = Стр.Количество;			НоваяСтр.Цена = Стр.Цена;			НоваяСтр.Сумма = Стр.Сумма;		КонецЦикла;	КонецЕсли;КонецПроцедурыПроцедура ОбработкаПроведения(Отказ, РежимПроведения)	Движения.ОстаткиТоваров.Записывать = Истина;	Движения.ВзаиморасчетыСКонтрагентами.Записывать = Истина;		ИтогСумма = 0;	Для Каждого СтрокаТЧ Из Товары Цикл		Если СтрокаТЧ.Количество <= 0 Тогда			Сообщение = Новый СообщениеПользователю;			Сообщение.Текст = "Количество должно быть больше нуля в строке " + СтрокаТЧ.НомерСтроки;			Сообщение.Сообщить();			Отказ = Истина;			Возврат;		КонецЕсли;				ДвижениеОстатки = Движения.ОстаткиТоваров.ДобавитьПриход();		ДвижениеОстатки.Период = Дата;		ДвижениеОстатки.Склад = Склад;		ДвижениеОстатки.Номенклатура = СтрокаТЧ.Номенклатура;		ДвижениеОстатки.Количество = СтрокаТЧ.Количество;				ИтогСумма = ИтогСумма + СтрокаТЧ.Сумма;	КонецЦикла;			Если ИтогСумма > 0 И ЗначениеЗаполнено(Договор) Тогда		ДвижениеДолг = Движения.ВзаиморасчетыСКонтрагентами.ДобавитьПриход();		ДвижениеДолг.Период = Дата;		ДвижениеДолг.Контрагент = Клиент;		ДвижениеДолг.Договор = Договор;		ДвижениеДолг.СуммаДолга = ИтогСумма;	КонецЕсли;КонецПроцедуры