 Процедура ОбработкаПроведения(Отказ, РежимПроведения)	Движения.РезервыТоваров.Записывать = Истина;		Если СтатусЗаказа = Перечисления.СтатусыЗаказов.ВРезерве 		Или СтатусЗаказа = Перечисления.СтатусыЗаказов.КОтгрузке Тогда				Для Каждого СтрокаТЧ Из Товары Цикл			Если СтрокаТЧ.Количество <= 0 Тогда				Сообщение = Новый СообщениеПользователю;				Сообщение.Текст = "Количество должно быть больше нуля в строке " + СтрокаТЧ.НомерСтроки;				Сообщение.Сообщить();				Отказ = Истина;				Возврат;			КонецЕсли;						Если Константы.КонтролироватьОстаткиПриОтгрузке.Получить() Тогда				Свободно = УправлениеЗапасамиСервер.ПолучитьСвободныйОстаток(					СтрокаТЧ.Номенклатура, Склад, МоментВремени(), Ссылка);				Если Свободно < СтрокаТЧ.Количество Тогда					Сообщение = Новый СообщениеПользователю;					Сообщение.Текст = "Недостаточно свободного остатка товара """ + СтрокаТЧ.Номенклатура 						+ """. Доступно: " + Свободно + ", требуется: " + СтрокаТЧ.Количество;					Сообщение.Сообщить();					Отказ = Истина;					Возврат;				КонецЕсли;			КонецЕсли;						Движение = Движения.РезервыТоваров.ДобавитьПриход();			Движение.Период = Дата;			Движение.Склад = Склад;			Движение.ЗаказКлиента = Ссылка;			Движение.Номенклатура = СтрокаТЧ.Номенклатура;			Движение.Количество = СтрокаТЧ.Количество;		КонецЦикла;	КонецЕсли;КонецПроцедуры